rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    match /members/{memberId} {
      // Anyone can create a registration document (unauthenticated or newly authenticated)
      allow create: if true;
      
      // Only admins can read/update/delete all member documents.
      // Users can also read their own document so they can log in and view their ID card.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == memberId);
      allow update, delete: if isAdmin();
    }

    // Default catch-all for any other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
